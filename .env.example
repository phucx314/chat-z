# Copy file này thành .env rồi điền key của bạn vào
# cp .env.example .env

# ── API Keys ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
MIMO_API_KEY=...
DS_API_KEY=your-deepseek-api-key

# ── Default Provider Settings (tuỳ chọn) ─────────────────────────────────────
PROVIDER=DeepSeek
BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-flash

# Nếu cần Anthropic-compatible endpoint của DeepSeek:
# BASE_URL=https://api.deepseek.com/anthropic
